# Copy via Doppler instead of editing this file by hand when possible:
#   pnpm dev:secrets
#   doppler secrets download --no-file --format env > .env
#
# Neon (shared by Vercel + Cloudflare)
DATABASE_URL=
NEON_AUTH_BASE_URL=

# App URL differs per host/deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IGDB (Twitch client credentials) — sync CLI + admin only
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Unlock /admin/sync
ADMIN_SYNC_SECRET=test

# Optional: set by CI for preview metadata
VERCEL_ENV=
CF_PAGES=
