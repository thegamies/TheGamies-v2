# Copy via Doppler instead of editing this file by hand when possible:
#   pnpm dev:secrets
#   doppler secrets download --no-file --format env > .env
#
# Neon (shared by Vercel + Cloudflare)
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Cookie signing for Neon Auth sessions (32+ chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# App URL differs per host/deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: comma-separated hostnames for next.dev when using a LAN IP / alias
# (also add the full origin in Neon Auth → Domains — LAN is not covered by localhost)
# ALLOWED_DEV_ORIGINS=192.168.1.164

# IGDB (Twitch client credentials) — sync CLI + admin only
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Unlock /admin/sync
ADMIN_SYNC_SECRET=test

# Optional: set by CI for preview metadata
VERCEL_ENV=
CF_PAGES=
