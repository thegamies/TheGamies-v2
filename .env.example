# Copy via Doppler instead of editing this file by hand when possible:
#   pnpm dev:secrets
#   doppler secrets download --no-file --format env > .env
#
# Neon (Cloudflare Workers host)
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Cookie signing for Neon Auth sessions (32+ chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# App URL differs per host/deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google Analytics 4 measurement id (public). Unset = no gtag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Neon Auth Users directory delete (Console → Auth → Users).
# Same project API key as branch deploys. Unset = close via neon_auth SQL only.
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=

# Optional: extra hostnames for next dev (LAN IPs on this machine are picked up
# automatically). Also add the full origin in Neon Auth → Domains.
# ALLOWED_DEV_ORIGINS=my-laptop.local

# IGDB (Twitch client credentials) — sync CLI + admin only
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: From address for Auth mail (Cloudflare Email Sending)
# AUTH_EMAIL_FROM=The Gamies <noreply@thegamies.gg>

# Optional: set by some hosts for preview metadata
CF_PAGES=
