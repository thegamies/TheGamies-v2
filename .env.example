# Copy via Doppler instead of editing this file by hand when possible:
#   pnpm dev:secrets
#   doppler secrets download --no-file --format env > .env
#
# Neon Postgres (Cloudflare Workers host)
DATABASE_URL=

# Better Auth (in-Worker). 32+ chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Absolute app origin for email / OAuth links (defaults to NEXT_PUBLIC_APP_URL).
# BETTER_AUTH_URL=http://localhost:3000
# Google OAuth. Redirect URI: {app origin}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# App URL differs per host/deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Unset = site GA4 property `G-MFFRTT6HFF`. `off` disables gtag.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=off

# Optional. Unset = site AdSense publisher. `off` disables AdSense.
# NEXT_PUBLIC_ADSENSE_CLIENT=off
# Display unit for the site-bottom banner. Unset = site unit `2718908461`.
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=off
# Non-monetized test ads. Unset = on in next dev, off in production.
# NEXT_PUBLIC_ADSENSE_TEST=on

# Optional: Neon API for CI / PR database branches (not Auth user delete).
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=

# Optional: extra hostnames for next dev (LAN IPs on this machine are picked up
# automatically).
# ALLOWED_DEV_ORIGINS=my-laptop.local

# IGDB (Twitch client credentials) — sync CLI + admin only
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: From address for Auth mail (Cloudflare Email Sending)
# AUTH_EMAIL_FROM=The Gamies <noreply@thegamies.gg>

# Optional: set by some hosts for preview metadata
CF_PAGES=
