{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@thegamies/db": ["../../packages/db/src/index.ts"],
      "@thegamies/db/schema": ["../../packages/db/src/schema.ts"],
      "@thegamies/igdb": ["../../packages/igdb/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "secrets.d.ts"]
}
